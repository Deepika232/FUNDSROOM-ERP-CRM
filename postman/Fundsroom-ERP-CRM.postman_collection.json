          "name": "Create Challan (Draft)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"<customer-uuid>\",\n  \"items\": [\n    {\n      \"productId\": \"<product-uuid>\",\n      \"quantity\": 10\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/challans",
              "host": ["{{baseUrl}}"],
              "path": ["challans"]
            },
            "description": "Create a new draft challan. Requires ADMIN or SALES role. Replace UUIDs with actual values."
          },
          "response": []
        },
