# Docker Environment Variables Template
# Copy this file to .env and fill in real values for Docker deployment
# DO NOT commit the .env file

# PostgreSQL Database
POSTGRES_USER=fundsroom
POSTGRES_PASSWORD=change_me_in_production_use_strong_password
POSTGRES_DB=fundsroom_erp

# Backend
JWT_SECRET=change_me_in_production_use_64_char_hex_secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost

# Frontend
VITE_API_BASE_URL=http://localhost:5001/api