# Fundsroom ERP + CRM — Backend Environment Template
# Copy this file to `.env` and fill in real values for local development.
# The `.env` file is GITIGNORED — never commit it.

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection string
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>?schema=public
DATABASE_URL="postgresql://postgres:YOUR_LOCAL_DB_PASSWORD@localhost:5432/fundsroom_erp?schema=public"

# JWT authentication (REQUIRED — use a long, cryptographically random secret)
# Generate with:  openssl rand -hex 32   (or:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="REPLACE_ME_WITH_64_CHAR_HEX_SECRET_FROM_OPENSSL_RAND_HEX_32"
JWT_EXPIRES_IN="7d"

# CORS — allowed origin for the frontend dev server
CORS_ORIGIN="http://localhost:5173"
